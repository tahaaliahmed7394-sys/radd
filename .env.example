# ردّ — Radd
# Copy to .env and adjust. Never commit .env

# Local API server port (Express)
PORT=8787

# SQLite file location (relative to the project root)
DATABASE_PATH=data/radd.sqlite

# Frontend API base (leave empty to use same-origin /api with the Vite proxy)
VITE_API_URL=

# WhatsApp Hybrid mode
# demo  = simulation only (default)
# cloud = WhatsApp Cloud API (Meta). Requires the vars below.
WHATSAPP_MODE=demo

# WhatsApp Cloud API (keep secret, never expose in frontend)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional: app secret for webhook signature validation
WHATSAPP_APP_SECRET=
# Business ID in Radd to receive WhatsApp messages (default: first business)
WHATSAPP_BUSINESS_ID=1
