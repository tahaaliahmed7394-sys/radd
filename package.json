{
  "name": "radd",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ردّ — منصة ردود تلقائية وحجز مواعيد وطلبات للشركات الصغيرة",
  "scripts": {
    "dev": "concurrently -n API,WEB -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/cairo": "5.2.5",
    "@fontsource/inter": "5.2.5",
    "better-sqlite3": "13.2.0",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "4.21.2",
    "framer-motion": "12.15.0",
    "i18next": "25.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "0.511.0",
    "motion-dom": "12.15.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "15.5.2",
    "react-router-dom": "7.6.2",
    "recharts": "2.15.3",
    "zustand": "5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@types/node": "22.15.21",
    "@types/react": "19.1.5",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.4.1",
    "autoprefixer": "10.4.21",
    "concurrently": "9.1.2",
    "postcss": "8.5.3",
    "sharp": "0.34.1",
    "supertest": "7.1.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "3.1.4"
  }
}
